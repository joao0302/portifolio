{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portifolio",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "jpfreitasdev.com.br",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
